      { "text": "Bon dia. Em dic Jordi.", "cue": "Good morning. My name is Jordi." },
      { "text": "Sóc de Girona.", "cue": "I am from Girona." },
      { "text": "Cada matí saludo els veïns.", "cue": "Every morning I greet the neighbours." },
      { "text": "A la tarda dic bona tarda.", "cue": "In the afternoon I say good afternoon." },
      { "text": "Quan conec algú, dic encantat.", "cue": "When I meet someone, I say pleased to meet you." },
      { "text": "I al final dic adéu.", "cue": "And at the end I say goodbye." }
    ]
