    {
      "id": "a2-01",
      "title": "Ser: who and where from",
      "goal": "Say who you are, where you're from and what you do.",
      "note": "**Ser** works like Castellano ser for identity, origin and profession. Professions go without an article, as in Castellano: **Soc metge.**\n\nSpelling: since the 2017 IEC reform **soc** has no accent (you'll still see sóc in older texts). **És** and **són** keep theirs.",
      "tables": [
        {
          "title": "ser — present",
          "rows": [
            [
              "jo",
              "soc"
            ],
            [
              "tu",
              "ets"
            ],
            [
              "ell, ella, vostè",
              "és"
            ],
            [
              "nosaltres",
              "som"
            ],
            [
              "vosaltres",
              "sou"
            ],
            [
              "ells, elles, vostès",
              "són"
            ]
          ]
        }
      ],
      "vocab": [
        [
          "metge / metgessa",
          "médico/a"
        ],
        [
          "professor / professora",
          "profesor/a"
        ],
        [
          "d'on",
          "de dónde"
        ],
        [
          "també",
          "también"
        ],
        [
          "però",
          "pero"
        ],
        [
          "aquí",
          "aquí"
        ]
      ],
      "items": [
        [
          "Soy de Barcelona.",
          "Soc de Barcelona."
        ],
        [
          "¿De dónde eres?",
          "D'on ets?"
        ],
        [
          "Ella es médica.",
          "(Ella) és metgessa."
        ],
        [
          "Somos estudiantes.",
          "Som estudiants."
        ],
        [
          "¿Sois de Valencia?",
          "Sou de València?"
        ],
        [
          "Ellos son mis amigos.",
          "(Ells) són els meus amics."
        ],
        [
          "Usted es el profesor, ¿verdad?",
          "Vostè és el professor, [oi|no|veritat]?"
        ],
        [
          "No soy de aquí, soy de Girona.",
          "No soc d'aquí, soc de Girona."
        ],
        [
          "¿Quién eres?",
          "Qui ets?"
        ],
        [
          "Mi hermana también es profesora.",
          "La meva germana també és professora."
